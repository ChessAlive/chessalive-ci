# Hyderabad release console. Copy to /etc/chessalive-build.env and keep mode 0600.
BUILD_TRIGGER_TOKEN=replace-with-a-long-random-password
BUILD_TRIGGER_PORT=8787
SOURCE_DIR=/opt/chessalive
BUILD_GIT_URL=https://github.com/ChessAlive/ChessAlive
PUBLIC_URL=https://chessalive.com
BUILD_ADMIN_EMAILS=lakshminathanlaky@gmail.com,vinoth121022@gmail.com,avinashr95@gmail.com

DEPLOY_REMOTE=yes
DEPLOY_HOST=144.24.117.171
DEPLOY_USER=ubuntu
DEPLOY_SSH_KEY=/home/opc/.ssh/chessalive-deploy
BUILD_ARCH=arm64

# Leave these disabled for code-only releases. Content publishing can write the live catalog.
SKIP_ASSETS=yes
SKIP_CONTENT=yes

# Required for release-completion and monitoring alert email.
BUILD_SMTP_URL=
BUILD_SMTP_FROM=ChessAlive Releases <no-reply@chessalive.com>
# The original ChessAlive Resend credentials are loaded from /etc/chessalive.env by systemd.
# CHESSALIVE_RESEND_API_KEY and CHESSALIVE_OTP_FROM must never be committed here.
