[Unit]
Description=ChessAlive application release (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chessalive
Group=chessalive
Environment=NODE_ENV=production
Environment=GOMEMLIMIT=5GiB
Environment=CHESSALIVE_COACH5_ENGINE=/usr/games/stockfish
# The Coach's browser engine (app ADR 2026-10-22, baseline 0.15): a web player's page runs their Coach
# searches over the hub. /etc/chessalive.env may set it false to switch it off.
Environment=CHESSALIVE_COACH5_BROWSER_ENGINE=true
EnvironmentFile=/etc/chessalive.env
EnvironmentFile=/etc/chessalive/slot-%i.env
ExecStart=/opt/chessalive/slots/%i/chessd
WorkingDirectory=/opt/chessalive/slots/%i
Restart=on-failure
RestartSec=2
TimeoutStopSec=90
# SIGTERM only chessd, which stops its V4 runtime child itself; systemd SIGKILLs anything left over.
KillMode=mixed
# Memory budget: Go 5 GiB (GOMEMLIMIT) + the Coach V4 runtime child (Node) up to 1.5 GiB.
MemoryMax=9G
MemoryHigh=7G
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/chessalive/data /run/chessalive
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
