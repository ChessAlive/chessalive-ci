[Unit]
Description=ChessAlive persistent connection gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chessalive
Group=chessalive
EnvironmentFile=/etc/chessalive/gateway.env
ExecStart=/opt/chessalive/bin/chessgate
Restart=on-failure
RestartSec=2
TimeoutStopSec=60
MemoryMax=1G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/chessalive /opt/chessalive/data/release
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
