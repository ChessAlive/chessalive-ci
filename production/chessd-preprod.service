[Unit]
Description=ChessAlive pre-production testing server (shared prod DB, isolated build & cgroup)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chessalive
Group=chessalive
Environment=NODE_ENV=production
Environment=GOMEMLIMIT=1500MiB
Environment=CHESSALIVE_COACH5_ENGINE=/usr/games/stockfish
Environment=CHESSALIVE_COACH5_BROWSER_ENGINE=true
EnvironmentFile=/etc/chessalive.env
EnvironmentFile=/etc/chessalive/preprod.env
ExecStart=/opt/chessalive/slots/preprod/chessd
WorkingDirectory=/opt/chessalive/slots/preprod
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=mixed
# Strictly isolated process/cgroup from live production: lower CPU/IO priority and bounded RAM.
CPUWeight=10
CPUQuota=60%
IOWeight=10
MemoryHigh=1536M
MemoryMax=2G
OOMScoreAdjust=700
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/chessalive/data/uploads /opt/chessalive-preprod/data
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
